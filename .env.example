# ===========================================
# FRONTEND (exposed to browser via VITE_ prefix)
# ===========================================
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Legacy fallback during migration only. Remove after legacy API keys are disabled.
VITE_SUPABASE_ANON_KEY=your_legacy_supabase_anon_key

# ===========================================
# BACKEND (Vercel serverless functions only)
# ===========================================

# Supabase (server-side admin operations)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy fallback during migration only. Remove after legacy API keys are disabled.
SUPABASE_SERVICE_ROLE_KEY=your_legacy_supabase_service_role_key

# xAI / Grok API - For chat, images (grok-imagine), and videos
# Models: grok-2-image-1212, grok-2-video-1212
GROK_API_KEY=your_xai_api_key

# Google Gemini API - For Nano Banana image models
# Models: gemini-2.5-flash-image, gemini-3-pro-image-preview
GEMINI_API_KEY=your_gemini_api_key

# OpenAI - For Whisper audio transcription and admin-only GPT Image generation
OPENAI_API_KEY=your_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-2

# fal.ai - For Kling 3.0 video generation
FAL_KEY=your_fal_key

# TiloPay - Payment processing and webhook verification
TILOPAY_API_KEY=your_tilopay_api_key
TILOPAY_API_USER=your_tilopay_api_user
TILOPAY_API_PASSWORD=your_tilopay_api_password
TILOPAY_WEBHOOK_SECRET=your_tilopay_webhook_secret
