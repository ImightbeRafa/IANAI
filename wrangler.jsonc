{
  // Advance AI on Cloudflare Workers, static-only. The Worker serves Static
  // Assets for everything; /api/* (and the two oauth-protected-resource
  // rewrites) get a 503 "Advance AI app is offline" — no container, no crons.
  // The AdvanceAiContainer class is deleted by migration v2. See
  // docs/operations/cloudflare-containers.md for the former container setup.
  "name": "advance-ai",
  "main": "src/cf-container-worker.ts",
  "compatibility_date": "2026-09-25",
  // No *.workers.dev subdomain and no preview URLs until Cloudflare Access is
  // in front of the preview environment (see env.preview below).
  "workers_dev": false,
  "preview_urls": false,

  // Static Assets are uploaded from the host-built `dist/` (not the Docker
  // build's copy). The deploy step must run, e.g.:
  //   VITE_APP_ENV=production VITE_SUPABASE_URL=... VITE_SUPABASE_ANON_KEY=... VITE_CREDITS_V1=... npm run build
  // before `wrangler deploy`. The Docker-built dist/ is only the container's
  // own fallback copy, not what Cloudflare serves at the edge.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Deviation from a run_worker_first path array: with an array, asset
    // requests never reach the Worker, so it can't add security headers or
    // 404 missing /assets/* files. `true` costs one Worker invocation per
    // asset request in exchange for both.
    "run_worker_first": true
  },

  // Explicitly empty, not omitted: omitting `triggers` leaves previously
  // deployed cron triggers in place, while `[]` removes them on deploy.
  "triggers": {
    "crons": []
  },

  "vars": {
    "APP_ENV": "production"
  },

  // v1 stays so the migration history is append-only; v2 deletes the class
  // (and its Durable Object storage) now that no container is bound.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AdvanceAiContainer"] },
    { "tag": "v2", "deleted_classes": ["AdvanceAiContainer"] }
  ],

  // Every block is repeated explicitly for env.preview: vars do not inherit
  // from the top level, and assets/triggers/migrations are repeated too so
  // this file doesn't depend on wrangler's inheritance rules at all.
  "env": {
    "preview": {
      "name": "advance-ai-preview",
      // GO flips this to true only after Cloudflare Access is in front of
      // this environment (see docs/operations/cloudflare-containers.md).
      "workers_dev": false,
      "preview_urls": false,

      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },

      // Explicitly empty, not omitted (see the top-level comment).
      "triggers": {
        "crons": []
      },

      // ACCESS_TEAM_DOMAIN / ACCESS_AUD are Worker-only — read by
      // cf/access-jwt.ts in handleFetch (see scripts/parity/env-diff.mjs's
      // WORKER_ONLY_VAR_NAMES). Non-secret placeholders; the real values
      // come with the Access application once it exists. A value
      // containing "REPLACE" is treated as unconfigured (fails closed, no
      // network call) by cf/access-jwt.ts.
      "vars": {
        "APP_ENV": "preview",
        "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
        "ACCESS_AUD": "REPLACE_WITH_ACCESS_APP_AUD"
      },

      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["AdvanceAiContainer"] },
        { "tag": "v2", "deleted_classes": ["AdvanceAiContainer"] }
      ]
    }
  }

  // No routes and no secrets here. Secret *names* (never values) are listed
  // in docs/operations/cloudflare-containers.md; set them with
  // `wrangler secret put <NAME>` (and `--env preview` for Preview).
}
